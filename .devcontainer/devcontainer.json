{
	"name": "Scaffold",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// Pinned to the major: 3.0.1 added the `/var/lib/containerd` volume this
		// setup used to declare by hand (overlay-on-overlay breaks the containerd
		// snapshotter), and 4.0.0 moved the iptables backend choice to container
		// start. `moby: false` is not optional here — install.sh exits 1 on Debian
		// trixie when it is true, since moby-cli was dropped from that distribution.
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false
		},
		"ghcr.io/devcontainers-extra/features/apt-get-packages:1": {},
		"ghcr.io/devcontainers-extra/features/pnpm:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/uv:1": {
			"version": "latest"
		}
	},
	"mounts": ["source=ai-tools-config-${devcontainerId},target=/ai-tools,type=volume"],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/ai-tools/.claude",
		"MEMPALACE_PALACE_PATH": "/ai-tools/.mempalace",
		"SERENA_HOME": "/ai-tools/.serena"
	},
	// uv symlinks tool executables into $HOME/.local/bin, which is not on the
	// image's PATH. `serena-hooks`, called by name from the four hooks in
	// .claude/settings.json, lives there.
	//
	// This has to be `remoteEnv`, not `containerEnv`: `${containerEnv:PATH}` is
	// only substituted in `remoteEnv`. Anywhere else it reaches `docker run` as
	// a literal, PATH stops resolving anything, and the entrypoint dies on
	// `cat: not found`. remoteEnv covers what needs it here — VS Code and its
	// sub-processes, so Claude Code and the hooks it spawns, plus terminals and
	// the lifecycle commands.
	"remoteEnv": {
		"PATH": "/home/node/.local/bin:${containerEnv:PATH}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"mhutchie.git-graph",
				"biomejs.biome",
				"github.vscode-github-actions",
				"bierner.github-markdown-preview",
				"bierner.markdown-preview-github-styles",
				"TypeScriptTeam.native-preview"
			],
			"settings": {
				"js/ts.tsserver.experimental.enableProjectDiagnostics": true,
				// Use the project's own TypeScript rather than the one bundled with
				// the extension. `typescript` is the native compiler since 7.0:
				// lib/getExePath.js resolves @typescript/typescript-<platform>-<arch>
				// and picks `tsc` or `tsgo` from the package name, and the extension
				// applies the same resolution to this path.
				"js/ts.tsdk.path": "node_modules/typescript/lib",
				// Machine-scoped (the Claude Code extension declares both as `scope: machine`), so they
				// cannot live in .vscode/settings.json. They belong here rather than in post-create.sh:
				// VS Code writes these into ~/.vscode-server/data/Machine/settings.json BEFORE attaching,
				// whereas postCreateCommand runs after the window is already attached — too late for the
				// session that triggered the rebuild, which then starts without them.
				"claudeCode.allowDangerouslySkipPermissions": true,
				"claudeCode.initialPermissionMode": "bypassPermissions"
			}
		}
	},
	"postCreateCommand": ".devcontainer/post-create.sh"
}
